def get_oss_versions():
    """从OSS获取补丁版本列表（供前端下拉框）"""
    try:
        # 调用ossutil列出OSS路径下的.tar.gz文件
        result = subprocess.run(
            ["ossutil", "ls", "oss://df-patch-no-delete/patch/6.6/6.6.9/latest/"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True,
            check=True
        )
        
        
        versions = []
        seen_dates = set()
        # 解析输出，提取版本（格式：08-20250519-12345-ALL.tar.gz）
        for line in result.stdout.split('\n'):
            if '.tar.gz' in line:
                match = re.search(r'(\d{2}-\d{8})-\d{5}-ALL\.tar\.gz', line)
                if match:
                    version_str = match.group(1)  # 提取版本：08-20250519
                    date_str = version_str.split('-')[1]  # 提取日期：20250519
                    if date_str not in seen_dates:
                        seen_dates.add(date_str)
                        versions.append({
                            'value': version_str,
                            'display': version_str,
                            'date': date_str
                        })
        
        # 按日期升序排序
        versions.sort(key=lambda x: x['date'])
        write_log(f"从OSS获取版本成功，共{len(versions)}个版本")
        return versions
    except Exception as e:
        error_msg = f"OSS版本获取失败：{str(e)}"
        write_log(error_msg, level="ERROR")
        return []



def get_oss_versions():
    """从OSS获取补丁版本列表（供前端下拉框）
    仅筛选.tar.gz文件，前端显示格式：03-20250508-4572-FEATURE_aarch64
    """
    try:
        # 调用ossutil列出目标目录下的文件（-d：不递归子目录）
        result = subprocess.run(
            ["ossutil", "ls", "-d", "oss://df-patch-no-delete/patch/6.6/6.6.9/"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True,
            check=True
        )
        
        versions = []
        seen_versions = set() 
        # 解析输出：仅处理包含.tar.gz的行，提取前端需要的格式
        for line in result.stdout.split('\n'):
            line = line.strip()  # 去除行首尾空格、换行符
            # 1. 筛选.tar.gz文件（排除目录行和.md文件）
            if line and ".tar.gz" in line and not line.endswith('/'):
                # 2. 提取文件名（如"03-20250508-4572-FEATURE_aarch64.tar.gz"）
                file_name = line.split('/')[-1]  # 按"/"分割路径，取最后一段（文件名）
                # 3. 去掉后缀.tar.gz，得到前端显示的版本字符串
                display_version = file_name[:-len(".tar.gz")]  # 截取到".tar.gz"前
                
                # 4. 去重：避免同一版本字符串重复添加
                if display_version not in seen_versions:
                    seen_versions.add(display_version)
                    # 提取日期部分（用于排序，格式：20250508）
                    # 日期在版本字符串的第3-10位（如"03-20250508-4572-FEATURE_aarch64"）
                    date_match = re.search(r'(\d{8})', display_version)
                    date_str = date_match.group(1) if date_match else ""
                    
                    versions.append({
                        'value': display_version,
                        'display': display_version,  # 前端显示内容（如03-20250508-4572-FEATURE_aarch64）
                        'date': date_str
                    })
        versions.sort(key=lambda x: x['date'])
        write_log(f"从OSS获取版本成功，共{len(versions)}个有效.tar.gz版本")
        return versions
    
    except subprocess.CalledProcessError as e:
        error_msg = f"OSS命令执行失败：{e.stderr.strip()}"
        write_log(error_msg, level="ERROR")
        return []
    except Exception as e:
        error_msg = f"OSS版本获取失败：{str(e)}"
        write_log(error_msg, level="ERROR")
        return []



